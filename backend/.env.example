# ─────────────────────────────────────────────────────────────
# API de Luné by Kelin — plantilla de variables de entorno
# Copia este archivo a `.env` y rellena los valores.
# NUNCA subas el `.env` real (está en .gitignore).
#
# Las claves que guardan credenciales se dejan VACÍAS a propósito:
# un archivo de ejemplo no debe traer valores con forma de secreto,
# ni siquiera de mentira. Cada una explica en su comentario qué poner.
# ─────────────────────────────────────────────────────────────

# Entorno: `dev` en local, `prod` en el servidor (activa SSL de Postgres).
STAGE=dev

# Puerto en el que escucha la API.
PORT=3001

# Origen(es) permitido(s) por CORS. Varios: separados por coma.
FRONTEND_URL=http://localhost:5173

# ── Base de datos ────────────────────────────────────────────
# Opción A (local, con docker-compose): variables sueltas.
# Con el docker-compose de este repo, usuario y contraseña son ambos
# `postgres` (ver docker-compose.yml).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=luneby
DB_USERNAME=
DB_PASSWORD=

# Opción B (Supabase / cualquier Postgres gestionado): connection string.
# Si `DATABASE_URL` está definida, tiene prioridad sobre las DB_* de arriba.
# Formato: postgresql://usuario:contrasena@host:5432/postgres
DATABASE_URL=

# ── Autenticación (JWT) ──────────────────────────────────────
# Cadena larga y aleatoria. Genera una con:  openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=2h

# URL pública de la propia API (para componer enlaces absolutos).
HOST_API=http://localhost:3001/api

# ── Inicio de sesión con Google ─────────────────────────────
# Client ID de OAuth (Web application) de Google Cloud. Es público (también
# va en el frontend como VITE_GOOGLE_CLIENT_ID). Sirve para validar el
# `audience` del ID token. Formato: <numero>-<hash>.apps.googleusercontent.com
GOOGLE_CLIENT_ID=

# ── Almacenamiento de imágenes (opcional) ────────────────────
# Sin estas variables, las imágenes subidas se guardan en disco local
# (efímero). Con ellas, se suben a Supabase Storage.
# SUPABASE_URL: https://<ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY: la service_role key del panel de Supabase.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=service-images

# ── Correo (Resend) ──────────────────────────────────────────
# Avisa a la administradora por correo cuando se agenda una cita nueva.
# Sin RESEND_API_KEY o ADMIN_EMAIL, simplemente no se envía nada (no rompe
# la reserva). Crea la key en https://resend.com/api-keys.
RESEND_API_KEY=
ADMIN_EMAIL=
# Remitente: sin dominio propio verificado en Resend, usa el de onboarding
# que la propia Resend provee para pruebas.
MAIL_FROM=
