# ─────────────────────────────────────────────────────────────
# API de Luné by Kelin — plantilla de variables de entorno
# Copia este archivo a `.env` y rellena los valores.
# NUNCA subas el `.env` real (está en .gitignore).
# ─────────────────────────────────────────────────────────────

# Entorno: `dev` en local, `prod` en el servidor (activa SSL de Postgres).
STAGE=dev

# Puerto en el que escucha la API.
PORT=3001

# Origen(es) permitido(s) por CORS. Varios: separados por coma.
FRONTEND_URL=http://localhost:5173

# ── Base de datos ────────────────────────────────────────────
# Opción A (local, con docker-compose): variables sueltas.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=luneby
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Opción B (Supabase / cualquier Postgres gestionado): connection string.
# Si `DATABASE_URL` está definida, tiene prioridad sobre las DB_* de arriba.
# postgresql://usuario:password@host:5432/postgres
# DATABASE_URL=

# ── Autenticación (JWT) ──────────────────────────────────────
# Cadena larga y aleatoria. Genera una con:  openssl rand -base64 48
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=2h

# URL pública de la propia API (para componer enlaces absolutos).
HOST_API=http://localhost:3001/api

# ── Almacenamiento de imágenes (opcional) ────────────────────
# Sin estas variables, las imágenes subidas se guardan en disco local
# (efímero). Con ellas, se suben a Supabase Storage.
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=service-images
