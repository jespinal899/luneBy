# Referencia local del backend ya terminado (no versionar)
backend_ref/

# Dependencias y artefactos de build (cada app tiene su .gitignore,
# esto es una red de seguridad a nivel monorepo)
**/node_modules/
**/dist/
**/coverage/

# ...excepto el reporte de cobertura versionado a propósito en la raíz
# (docs/checklist de calidad de código: coverage-summary.json + lcov.info).
!/coverage/
!/coverage/coverage-summary.json
!/coverage/lcov.info

# Variables de entorno reales. Ningún archivo `.env*` se versiona nunca:
# las plantillas viven en `env.example` (sin punto inicial).
**/.env
**/.env.*

# Estado local de la CLI de Vercel (`vercel link` escribe acá los ids del
# proyecto). No son credenciales, pero es configuración de la máquina, no
# del repo.
**/.vercel

# Logs y basura del SO / editores
*.log
.DS_Store
Thumbs.db

.vercel
.env*
