# ─────────────────────────────────────────────────────────────
# Frontend de Luné by Kelin — plantilla de variables de entorno
# Copia este archivo a `.env` y ajusta los valores.
# Solo las variables con prefijo `VITE_` llegan al navegador.
# ─────────────────────────────────────────────────────────────

# URL base de la API (incluye el prefijo `/api`).
# Local:      http://localhost:3001/api
# Producción: https://tu-api.onrender.com/api
VITE_API_URL=http://localhost:3001/api

# Client ID de OAuth de Google (Web application). Es público.
# Debe coincidir con GOOGLE_CLIENT_ID del backend.
VITE_GOOGLE_CLIENT_ID=600770790651-scb8ugh5ic5ni7ora0ovdd341nkel5pt.apps.googleusercontent.com
